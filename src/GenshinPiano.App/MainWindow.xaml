<Window x:Class="GenshinPiano.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource PanelBackgroundBrush}"
              Foreground="{DynamicResource PrimaryTextBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="{DynamicResource Menu_File}"
                      SubmenuOpened="MenuItem_OnSubmenuOpened"
                      Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{DynamicResource Menu_New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{DynamicResource Menu_Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_Exit}" Click="ExitMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu_Edit}"
                      Style="{StaticResource TopLevelMenuItemStyle}"
                      IsEnabled="False" />
            <MenuItem Header="{DynamicResource Menu_Play}"
                      Style="{StaticResource TopLevelMenuItemStyle}"
                      IsEnabled="False" />
            <MenuItem Header="{DynamicResource Menu_Import}"
                      Style="{StaticResource TopLevelMenuItemStyle}"
                      IsEnabled="False" />
            <MenuItem Header="{DynamicResource Menu_Settings}"
                      SubmenuOpened="MenuItem_OnSubmenuOpened"
                      Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{DynamicResource Menu_Theme}"
                          SubmenuOpened="MenuItem_OnSubmenuOpened">
                    <MenuItem Header="{DynamicResource Menu_ThemeDark}"
                              Command="{Binding UseDarkThemeCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsDarkTheme, Mode=OneWay}" />
                    <MenuItem Header="{DynamicResource Menu_ThemeLight}"
                              Command="{Binding UseLightThemeCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsLightTheme, Mode=OneWay}" />
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu_Language}"
                          SubmenuOpened="MenuItem_OnSubmenuOpened">
                    <MenuItem Header="{DynamicResource Menu_LanguageChinese}"
                              Command="{Binding UseChineseCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsChinese, Mode=OneWay}" />
                    <MenuItem Header="{DynamicResource Menu_LanguageEnglish}"
                              Command="{Binding UseEnglishCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsEnglish, Mode=OneWay}" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom"
                   Padding="8,4"
                   Background="{DynamicResource PanelBackgroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Background="{DynamicResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="GenshinPiano"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource App_DevelopmentPreview}"
                               Margin="0,4,0,28"
                               Foreground="{DynamicResource AccentBrush}" />

                    <TextBlock Text="{DynamicResource Sidebar_CurrentScore}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding ScoreTitle}"
                               Margin="0,6,0,20"
                               FontSize="16"
                               TextWrapping="Wrap" />

                    <Button Content="{DynamicResource Action_NewScore}"
                            Command="{Binding NewCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="{DynamicResource Action_OpenGpiano}"
                            Command="{Binding OpenCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Style="{StaticResource AppButtonStyle}" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="32">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="36">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                        <TextBlock Text="{DynamicResource Hero_Eyebrow}"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Hero_Title}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Margin="0,14,0,28"
                                   Text="{DynamicResource Hero_Description}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{DynamicResource Action_NewScore}"
                                    Command="{Binding NewCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="{DynamicResource Action_OpenFile}"
                                    Command="{Binding OpenCommand}"
                                    Style="{StaticResource AppButtonStyle}" />
                            <Button Content="{DynamicResource Action_SaveAs}"
                                    Command="{Binding SaveAsCommand}"
                                    Style="{StaticResource AppButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
