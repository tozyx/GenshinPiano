<Window x:Class="GenshinPiano.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GenshinPiano.App.Controls"
        xmlns:updates="clr-namespace:GenshinPiano.Application.Updates;assembly=GenshinPiano.Application"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Icon="Assets/Icons/GenshinPiano.ico"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        Style="{StaticResource AppWindowStyle}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        PreviewDragOver="MainWindow_OnPreviewDragOver"
        Drop="MainWindow_OnDrop"
        Closing="MainWindow_OnClosing"
        Closed="MainWindow_OnClosed"
        DataContextChanged="MainWindow_OnDataContextChanged"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        Deactivated="MainWindow_OnDeactivated"
        StateChanged="MainWindow_OnStateChanged"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="AnimatedCheckableMenuItemStyle"
               TargetType="MenuItem"
               BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="StaysOpenOnClick" Value="True" />
            <EventSetter Event="Checked" Handler="AnimatedCheckableMenuItem_OnCheckStateChanged" />
            <EventSetter Event="Unchecked" Handler="AnimatedCheckableMenuItem_OnCheckStateChanged" />
        </Style>

        <Style x:Key="UpdateMenuItemStyle"
               TargetType="MenuItem"
               BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="MinWidth" Value="{DynamicResource Menu_UpdateSubmenuItemMinWidth}" />
        </Style>

        <Style x:Key="AnimatedUpdateCheckableMenuItemStyle"
               TargetType="MenuItem"
               BasedOn="{StaticResource AnimatedCheckableMenuItemStyle}">
            <Setter Property="MinWidth" Value="{DynamicResource Menu_UpdateSubmenuItemMinWidth}" />
        </Style>

        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter x:Name="IconContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconContent"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.1" Duration="0:0:0.13" />
                                            <DoubleAnimation Storyboard.TargetName="IconContent"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.1" Duration="0:0:0.13" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconContent"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="IconContent"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconContent" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Setter.Value>
                                </Setter>
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarStaticIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarPlayButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="13" />
        </Style>
        <Style x:Key="SidebarStopButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="ScoreFileItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Padding="9,8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource SurfaceBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                        Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource AccentSurfaceBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="5,5,2,2">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Border>
                            <Border Height="2" VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding TogglePlaybackCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="36"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="12,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="18"
                           Height="18"
                           Margin="0,0,8,0"
                           Source="Assets/Icons/GenshinPiano.ico"
                           Stretch="Uniform" />
                    <TextBlock Text="{Binding WindowTitle}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button ToolTip="{DynamicResource Window_Minimize}"
                            Style="{StaticResource WindowCaptionButtonStyle}"
                            Click="MinimizeButton_OnClick">
                        <Grid Width="14" Height="14">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  Data="M 2.5,7.5 H 11.5" />
                        </Grid>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton"
                            ToolTip="{DynamicResource Window_Maximize}"
                            Style="{StaticResource WindowCaptionButtonStyle}"
                            Click="MaximizeRestoreButton_OnClick">
                        <Grid Width="14" Height="14">
                            <Path x:Name="MaximizeIcon"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M 2.5,2.5 H 11.5 V 11.5 H 2.5 Z" />
                            <Path x:Name="RestoreIcon"
                                  Visibility="Collapsed"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M 4.5,2.5 H 11.5 V 9.5 M 2.5,4.5 H 9.5 V 11.5 H 2.5 Z" />
                        </Grid>
                    </Button>
                    <Button ToolTip="{DynamicResource Window_Close}"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_OnClick">
                        <Grid Width="14" Height="14">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  Data="M 3,3 L 11,11 M 11,3 L 3,11" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource PanelBackgroundBrush}"
              Foreground="{DynamicResource PrimaryTextBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <MenuItem x:Name="FileMenuItem"
                      Header="{DynamicResource Menu_File}"
                      SubmenuOpened="MenuItem_OnSubmenuOpened"
                      Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{DynamicResource Menu_New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{DynamicResource Menu_Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_Exit}" Click="ExitMenuItem_OnClick" />
            </MenuItem>
            <MenuItem x:Name="EditMenuItem"
                      Header="{DynamicResource Menu_Edit}"
                      SubmenuOpened="EditMenuItem_OnSubmenuOpened"
                      Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{DynamicResource Editor_PitchLabels}"
                          SubmenuOpened="MenuItem_OnSubmenuOpened">
                    <MenuItem x:Name="PitchLettersWithKeyMenuItem"
                              Header="{DynamicResource Editor_PitchLettersWithKey}"
                              Tag="LetterWithKey"
                              IsCheckable="True"
                              Click="PitchLabelMenuItem_OnClick" />
                    <MenuItem x:Name="PitchNumbersWithKeyMenuItem"
                              Header="{DynamicResource Editor_PitchNumbersWithKey}"
                              Tag="NumberedWithKey"
                              IsCheckable="True"
                              Click="PitchLabelMenuItem_OnClick" />
                    <MenuItem x:Name="PitchLettersOnlyMenuItem"
                              Header="{DynamicResource Editor_PitchLettersOnly}"
                              Tag="LetterOnly"
                              IsCheckable="True"
                              Click="PitchLabelMenuItem_OnClick" />
                    <MenuItem x:Name="PitchNumbersOnlyMenuItem"
                              Header="{DynamicResource Editor_PitchNumbersOnly}"
                              Tag="NumberedOnly"
                              IsCheckable="True"
                              Click="PitchLabelMenuItem_OnClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu_ScoreAnalysisAndTranspose}"
                          Click="ScoreAnalysisMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_OptimizeDurations}"
                          Click="OptimizeDurationsMenuItem_OnClick" />
                <MenuItem Header="{DynamicResource Menu_GenerateShortPressDurations}"
                          Click="GenerateShortPressDurationsMenuItem_OnClick" />
            </MenuItem>
            <MenuItem x:Name="ImportMenuItem"
                      Header="{DynamicResource Menu_Import}"
                      SubmenuOpened="MenuItem_OnSubmenuOpened"
                      Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{DynamicResource Menu_ImportLegacyBatch}"
                          Command="{Binding ConvertLegacyScoresCommand}" />
                <MenuItem Header="{DynamicResource Menu_ImportMidiBatch}"
                          Click="ImportMidiBatchMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu_Settings}"
                      SubmenuOpened="SettingsMenuItem_OnSubmenuOpened"
                      Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{DynamicResource Menu_Theme}"
                          SubmenuOpened="MenuItem_OnSubmenuOpened">
                    <MenuItem Header="{DynamicResource Menu_ThemeDark}"
                              Command="{Binding UseDarkThemeCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsDarkTheme, Mode=OneWay}" />
                    <MenuItem Header="{DynamicResource Menu_ThemeLight}"
                              Command="{Binding UseLightThemeCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsLightTheme, Mode=OneWay}" />
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu_Language}"
                          SubmenuOpened="MenuItem_OnSubmenuOpened">
                    <MenuItem Header="{DynamicResource Menu_LanguageChinese}"
                              Command="{Binding UseChineseCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsChinese, Mode=OneWay}" />
                    <MenuItem Header="{DynamicResource Menu_LanguageEnglish}"
                              Command="{Binding UseEnglishCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsEnglish, Mode=OneWay}" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="UpdatesMenuItem"
                          Header="{DynamicResource Menu_Updates}"
                          SubmenuOpened="UpdatesMenuItem_OnSubmenuOpened">
                    <MenuItem Header="{DynamicResource Menu_AllowNetwork}"
                              IsCheckable="True"
                              Style="{StaticResource AnimatedUpdateCheckableMenuItemStyle}"
                              IsChecked="{Binding UpdateStatus.NetworkAccessEnabled, Mode=TwoWay}" />
                    <Separator x:Name="UpdateNetworkSeparator"
                               MinWidth="{DynamicResource Menu_UpdateSubmenuItemMinWidth}" />
                    <MenuItem x:Name="AutomaticUpdatesMenuItem"
                              Header="{DynamicResource Menu_AutomaticUpdates}"
                              IsCheckable="True"
                              Style="{StaticResource AnimatedUpdateCheckableMenuItemStyle}"
                              IsEnabled="{Binding UpdateStatus.NetworkAccessEnabled}"
                              IsChecked="{Binding UpdateStatus.AutomaticUpdatesEnabled, Mode=TwoWay}" />
                    <MenuItem x:Name="PreviewUpdatesMenuItem"
                              Header="{DynamicResource Menu_PreviewUpdates}"
                              IsCheckable="True"
                              Style="{StaticResource AnimatedUpdateCheckableMenuItemStyle}"
                              IsEnabled="{Binding UpdateStatus.NetworkAccessEnabled}"
                              IsChecked="{Binding UpdateStatus.PreviewUpdatesEnabled, Mode=TwoWay}" />
                    <MenuItem x:Name="CheckForUpdatesMenuItem"
                              Header="{DynamicResource Menu_CheckForUpdates}"
                              Style="{StaticResource UpdateMenuItemStyle}"
                              Command="{Binding UpdateStatus.CheckForUpdatesCommand}" />
                    <MenuItem x:Name="RollbackMenuItem"
                              Header="{DynamicResource Menu_RollbackUpdate}"
                              Style="{StaticResource UpdateMenuItemStyle}"
                              Click="RollbackMenuItem_OnClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu_FileAssociation}"
                          SubmenuOpened="MenuItem_OnSubmenuOpened">
                    <MenuItem x:Name="RegisterGpianoAssociationMenuItem"
                              Header="{DynamicResource Menu_RegisterGpianoAssociation}"
                              Click="RegisterGpianoAssociationMenuItem_OnClick" />
                    <MenuItem x:Name="UnregisterGpianoAssociationMenuItem"
                              Header="{DynamicResource Menu_UnregisterGpianoAssociation}"
                              Click="UnregisterGpianoAssociationMenuItem_OnClick" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu_Help}"
                      SubmenuOpened="MenuItem_OnSubmenuOpened"
                      Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{DynamicResource Menu_AboutGenshinPiano}"
                          Click="AboutMenuItem_OnClick" />
                <MenuItem Header="{DynamicResource Menu_ViewReleaseNotes}"
                          Click="ViewReleaseNotesMenuItem_OnClick" />
                <Separator />
                <MenuItem Click="GitHubFeedbackMenuItem_OnClick">
                    <MenuItem.Header>
                        <Grid MinWidth="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Menu_GitHubFeedback}"
                                       VerticalAlignment="Center" />
                            <Viewbox Grid.Column="1"
                                     Width="14"
                                     Height="14"
                                     Margin="18,0,0,0"
                                     VerticalAlignment="Center"
                                     Stretch="Uniform">
                                <Canvas Width="16" Height="16">
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.45"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M6.4,10.7 L5.4,11.7 C4.2,12.9 2.5,12.9 1.4,11.8 C0.3,10.7 0.3,9 1.5,7.8 L3.5,5.8 C4.4,4.9 5.8,4.7 6.9,5.3" />
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.45"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M9.6,5.3 L10.6,4.3 C11.8,3.1 13.5,3.1 14.6,4.2 C15.7,5.3 15.7,7 14.5,8.2 L12.5,10.2 C11.6,11.1 10.2,11.3 9.1,10.7" />
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.45"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M5.7,10.3 L10.3,5.7" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom"
                   Padding="8,4"
                   Background="{DynamicResource PanelBackgroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem DockPanel.Dock="Right"
                           Padding="4,0"
                           Margin="0,0,6,0">
                <TextBlock Text="{Binding UpdateStatus.CurrentVersionText}"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right"
                           Padding="0"
                           Margin="0,0,10,0"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           ToolTip="{Binding UpdateStatus.StatusText}"
                           MouseLeftButtonUp="UpdateStatus_OnClick">
                <StatusBarItem.Style>
                    <Style TargetType="StatusBarItem">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateStatus.IsIndicatorVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StatusBarItem.Style>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding UpdateStatus.StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatus.Stage}"
                                                 Value="{x:Static updates:UpdateStage.Available}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding UpdateStatus.ProgressPercent, StringFormat={}{0}%}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatus.Stage}"
                                                 Value="{x:Static updates:UpdateStage.Downloading}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Width="24"
                            Height="22"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="False">
                        <controls:UpdateProgressRing Width="16" Height="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Progress="{Binding UpdateStatus.Progress}"
                                                     IsIndeterminate="{Binding UpdateStatus.IsIndeterminate}"
                                                     RingBrush="{DynamicResource AccentBrush}"
                                                     TrackBrush="{DynamicResource SecondaryTextBrush}"
                                                     StrokeThickness="1.6" />
                    </Border>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Background="{DynamicResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="GenshinPiano" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text=" v3" Margin="3,3,0,0" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>

                        <Border x:Name="CurrentScorePanel"
                                Padding="4,4" Margin="0,0,0,14"
                                Background="Transparent">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Sidebar_CurrentScore}"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Button x:Name="NewScoreButton"
                                            Width="17"
                                            Height="17"
                                            Padding="3"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SidebarIconButtonStyle}"
                                            Command="{Binding NewCommand}"
                                            ToolTip="{DynamicResource Action_NewScore}">
                                        <Path Width="9" Height="9"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource SecondaryTextBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M6,1 V11 M1,6 H11" />
                                    </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="CurrentScoreTitle"
                                               Text="{Binding ScoreTitle}"
                                               Margin="0,5,8,0"
                                               FontSize="17" FontWeight="SemiBold"
                                               LineHeight="22"
                                               LineStackingStrategy="BlockLineHeight"
                                               MaxHeight="66"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Cursor="Hand"
                                               RenderTransformOrigin="0,0.5"
                                               MouseLeftButtonDown="CurrentScoreTitle_OnMouseLeftButtonDown"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.045" Duration="0:0:0.14" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.045" Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1" Duration="0:0:0.16" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1" Duration="0:0:0.16" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <Grid x:Name="WorkspaceLibraryPanel" Grid.Row="1" Margin="0,6,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8"
                              ClipToBounds="False"
                              Panel.ZIndex="2">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{DynamicResource Sidebar_ScoreFolder}" />
                                <TextBlock Margin="0,3,6,0" Text="{Binding ScoreFolderName}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ScoreFolder}" />
                            </StackPanel>
                            <Grid x:Name="ScoreFolderToolbarHost"
                                  Panel.ZIndex="1"
                                  Width="206"
                                  Height="34"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  MouseEnter="ScoreFolderSearchArea_OnMouseEnter"
                                  MouseLeave="ScoreFolderSearchArea_OnMouseLeave">
                                <Button x:Name="OpenScoreFolderButton"
                                        Panel.ZIndex="0"
                                        Margin="0,0,60,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SidebarIconButtonStyle}"
                                        Command="{Binding OpenScoreFolderCommand}"
                                        ToolTip="{DynamicResource Action_OpenScoreFolder}">
                                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                                        <Canvas Width="18" Height="18">
                                            <Path Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                  Data="M2.5,4.5 H7 L8.5,6 H15.5 V13.5 H2.5 Z M2.5,7 H15.5" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <TextBox x:Name="ScoreFolderSearchTextBox"
                                         Panel.ZIndex="1"
                                         Width="176"
                                         Height="34"
                                         Margin="0,0,30,0"
                                         HorizontalAlignment="Right"
                                         Visibility="Collapsed"
                                         Style="{StaticResource SidebarSearchTextBoxStyle}"
                                         Padding="9,5,38,5"
                                         RenderTransformOrigin="1,0.5"
                                         Text="{Binding ScoreFolderSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Sidebar_SearchScores}"
                                         MouseEnter="ScoreFolderSearchArea_OnMouseEnter"
                                         MouseLeave="ScoreFolderSearchArea_OnMouseLeave">
                                    <TextBox.RenderTransform>
                                        <ScaleTransform ScaleX="0.05" ScaleY="1" />
                                    </TextBox.RenderTransform>
                                </TextBox>
                                <Button x:Name="ScoreFolderSearchButton"
                                        Panel.ZIndex="2"
                                        Margin="0,0,30,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SidebarStaticIconButtonStyle}"
                                        ToolTip="{DynamicResource Sidebar_SearchScores}"
                                        MouseEnter="ScoreFolderSearchButton_OnMouseEnter"
                                        MouseLeave="ScoreFolderSearchArea_OnMouseLeave"
                                        Click="ScoreFolderSearchButton_OnClick">
                                    <Viewbox x:Name="ScoreFolderSearchButtonIcon"
                                             Width="16" Height="16" Stretch="Uniform">
                                        <Canvas Width="18" Height="18">
                                            <Path Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M3.5,7.5 A4,4 0 1 1 11.5,7.5 A4,4 0 1 1 3.5,7.5 M10.5,10.5 L15,15" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Panel.ZIndex="2"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SidebarIconButtonStyle}"
                                        Command="{Binding RefreshScoreFolderCommand}"
                                        Click="RefreshScoreFolderButton_OnClick"
                                        ToolTip="{DynamicResource Action_RefreshFolder}">
                                    <Viewbox x:Name="RefreshScoreFolderIcon"
                                             Width="16" Height="16"
                                             Stretch="Uniform"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Viewbox.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Viewbox.RenderTransform>
                                        <Canvas Width="18" Height="18">
                                            <Path Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M14.5,6.5 A5.5,5.5 0 1 0 14.5,12 M14.5,3.5 L14.5,7.5 L10.5,7.5" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Grid>
                        <ListBox x:Name="WorkspaceFileList" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ScoreFileItemStyle}"
                                 ItemsSource="{Binding ScoreFolderFiles}"
                                 SelectedValuePath="Path"
                                 SelectedValue="{Binding CurrentSourcePath, Mode=OneWay}"
                                 SelectionChanged="WorkspaceFileList_OnSelectionChanged"
                                 PreviewMouseRightButtonDown="WorkspaceFileList_OnPreviewMouseRightButtonDown"
                                 ContextMenuOpening="WorkspaceFileList_OnContextMenuOpening"
                                 KeyDown="WorkspaceFileList_OnKeyDown"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Action_Rename}"
                                              Click="RenameScoreMenuItem_OnClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="184">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding FileType}"
                                                   FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid x:Name="GamePlaybackControls" Grid.Row="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Button Panel.ZIndex="1"
                                Command="{Binding TogglePlaybackCommand}"
                                Style="{StaticResource SidebarPlayButtonStyle}">
                            <Button.ToolTip>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Action_Play}" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                        <Condition Binding="{Binding IsPlaybackPaused}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="{DynamicResource Action_Pause}" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.ToolTip>
                            <Grid Width="28" Height="28">
                                <Path Fill="{DynamicResource AccentBrush}"
                                      Margin="3"
                                      Stretch="Uniform"
                                      Data="M5.5,3.4 Q4.5,2.85 4.5,4.2 L4.5,15.8 Q4.5,17.15 5.5,16.6 L16.8,10.8 Q18.2,10 16.8,9.2 Z">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                        <Condition Binding="{Binding IsPlaybackPaused}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Grid Width="22" Height="22">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                        <Condition Binding="{Binding IsPlaybackPaused}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Rectangle Width="5.5"
                                               Height="19"
                                               Margin="0,0,9,0"
                                               RadiusX="1.2"
                                               RadiusY="1.2"
                                               Fill="{DynamicResource AccentBrush}" />
                                    <Rectangle Width="5.5"
                                               Height="19"
                                               Margin="9,0,0,0"
                                               RadiusX="1.2"
                                               RadiusY="1.2"
                                               Fill="{DynamicResource AccentBrush}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <Border Margin="8,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="-52" />
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="IsHitTestVisible" Value="True" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform X="0" />
                                                </Setter.Value>
                                            </Setter>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1"
                                                                         Duration="0:0:0.18" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                         From="-52" To="0"
                                                                         Duration="0:0:0.22">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0"
                                                                         Duration="0:0:0.14" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                         From="0" To="-52"
                                                                         Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Command="{Binding StopCommand}"
                                    ToolTip="{DynamicResource Action_Stop}"
                                    Style="{StaticResource SidebarStopButtonStyle}">
                                <Rectangle Width="17"
                                           Height="17"
                                           RadiusX="2.5"
                                           RadiusY="2.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{DynamicResource StopIconBrush}" />
                            </Button>
                        </Border>
                        </StackPanel>

                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <controls:PianoRollEditor x:Name="PianoRollEditor"
                                              Score="{Binding CurrentScore, Mode=TwoWay}"
                                              AuditionStateChanged="PianoRollEditor_OnAuditionStateChanged" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
