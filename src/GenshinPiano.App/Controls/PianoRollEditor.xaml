<UserControl x:Class="GenshinPiano.App.Controls.PianoRollEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GenshinPiano.App.Controls"
             PreviewKeyDown="Root_OnPreviewKeyDown"
             PreviewTextInput="Root_OnPreviewTextInput"
             PreviewMouseWheel="Root_OnPreviewMouseWheel">
    <UserControl.Resources>
        <Style x:Key="BpmTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="6,0,2,0"
                                              VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,2,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        Click="BpmClearButton_OnClick">
                                    <Path Width="6"
                                          Height="6"
                                          Stretch="Fill"
                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M0,0 L6,6 M6,0 L0,6" />
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AuditionVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="30" ClipToBounds="False">
                            <Border Width="4"
                                    Margin="0,9"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource BorderBrush}"
                                    CornerRadius="2" />
                            <Border Width="4"
                                    Margin="0,9"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="2"
                                    RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border.RenderTransform>
                            </Border>
                            <Track x:Name="PART_Track"
                                   Margin="0,3"
                                   Orientation="Vertical"
                                   IsDirectionReversed="False"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Width="4"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Width="4"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource BorderBrush}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="18" Height="18">
                                                    <Ellipse Fill="{DynamicResource PanelBackgroundBrush}" />
                                                    <Ellipse Width="11"
                                                             Height="11"
                                                             Fill="{DynamicResource AccentBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="−"
                            Width="30"
                            Height="30"
                            Padding="0"
                            ToolTip="{DynamicResource Editor_ZoomOut}"
                            Click="ZoomOut_OnClick" />
                    <Button Content="+"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            Padding="0"
                            ToolTip="{DynamicResource Editor_ZoomIn}"
                            Click="ZoomIn_OnClick" />
                    <Button Content="↕−"
                            Width="34"
                            Height="30"
                            Margin="10,0,0,0"
                            Padding="0"
                            ToolTip="{DynamicResource Editor_VerticalZoomOut}"
                            Click="VerticalZoomOut_OnClick" />
                    <Button Content="↕+"
                            Width="34"
                            Height="30"
                            Margin="6,0,0,0"
                            Padding="0"
                            ToolTip="{DynamicResource Editor_VerticalZoomIn}"
                            Click="VerticalZoomIn_OnClick" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Editor_Grid}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox x:Name="SnapComboBox"
                              Width="78"
                              SelectedIndex="2"
                              SelectionChanged="SnapComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="1/4" Tag="1" />
                        <ComboBoxItem Content="1/8" Tag="2" />
                        <ComboBoxItem Content="1/16" Tag="4" />
                        <ComboBoxItem Content="1/32" Tag="8" />
                    </ComboBox>
                    <TextBlock Text="{DynamicResource Editor_Articulation}"
                               Margin="16,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox x:Name="ArticulationComboBox"
                              Width="86"
                              SelectedIndex="1"
                              SelectionChanged="ArticulationComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Editor_Legato}" Tag="Legato" />
                        <ComboBoxItem Content="{DynamicResource Editor_Natural}" Tag="Natural" />
                        <ComboBoxItem Content="{DynamicResource Editor_Detached}" Tag="Detached" />
                        <ComboBoxItem Content="{DynamicResource Editor_Staccato}" Tag="Staccato" />
                    </ComboBox>
                    <TextBlock Text="{DynamicResource Editor_PitchLabels}"
                               Margin="16,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox x:Name="PitchLabelComboBox"
                              Width="136"
                              SelectedIndex="0"
                              SelectionChanged="PitchLabelComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Editor_PitchLettersWithKey}" Tag="LetterWithKey" />
                        <ComboBoxItem Content="{DynamicResource Editor_PitchNumbersWithKey}" Tag="NumberedWithKey" />
                        <ComboBoxItem Content="{DynamicResource Editor_PitchLettersOnly}" Tag="LetterOnly" />
                        <ComboBoxItem Content="{DynamicResource Editor_PitchNumbersOnly}" Tag="NumberedOnly" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="18,0,0,0" Orientation="Horizontal">
                    <Button Content="↶"
                            Width="34"
                            Height="30"
                            Padding="0"
                            ToolTip="{DynamicResource Editor_Undo}"
                            Click="Undo_OnClick" />
                    <Button Content="↷"
                            Width="34"
                            Height="30"
                            Margin="6,0,0,0"
                            Padding="0"
                            ToolTip="{DynamicResource Editor_Redo}"
                            Click="Redo_OnClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="KeyboardScrollViewer"
                          Grid.Column="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <local:PianoRollKeyboard x:Name="KeyboardLabels"
                                         RowHeight="{Binding RowHeight, ElementName=Surface}"
                                         Background="{DynamicResource PanelBackgroundBrush}"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" />
            </ScrollViewer>

            <ScrollViewer x:Name="EditorScrollViewer"
                          Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          ScrollChanged="EditorScrollViewer_OnScrollChanged">
                <Grid>
                    <local:PianoRollSurface x:Name="Surface"
                                           Score="{Binding Score, ElementName=Root, Mode=TwoWay}"
                                           Background="{DynamicResource SurfaceBrush}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}"
                                           LabelMode="{Binding LabelMode, ElementName=KeyboardLabels}"
                                           NoteBrush="{DynamicResource AccentBrush}" />
                    <Border x:Name="PlaybackCursor"
                            Width="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            Background="{DynamicResource AccentBrush}"
                            RenderTransformOrigin="0.5,0">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Padding="12,5"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="BPM"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="BpmTextBox"
                             Width="64"
                             Height="28"
                             Style="{StaticResource BpmTextBoxStyle}"
                             MaxLength="6"
                             VerticalContentAlignment="Center"
                             Text="120"
                             LostFocus="BpmTextBox_OnLostFocus"
                             KeyDown="BpmTextBox_OnKeyDown" />
                    <ComboBox x:Name="AuditionInstrumentComboBox"
                              Width="94"
                              Height="28"
                              Margin="8,0,0,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="{DynamicResource Audition_Piano}" Tag="0" />
                        <ComboBoxItem Content="{DynamicResource Audition_Harp}" Tag="46" />
                        <ComboBoxItem Content="{DynamicResource Audition_Organ}" Tag="19" />
                    </ComboBox>
                    <Button x:Name="AuditionVolumeButton"
                            Width="30"
                            Height="28"
                            Margin="4,0,0,0"
                            Padding="6"
                            ToolTip="{DynamicResource Audition_Volume}"
                            Click="AuditionVolumeButton_OnClick">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="18" Height="18">
                                <Path Fill="{DynamicResource PrimaryTextBrush}"
                                      Data="M1,7 L5,7 L10,3 L10,15 L5,11 L1,11 Z" />
                                <Path Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M12,6 C15,8 15,10 12,12 M14,3.5 C18,7 18,11 14,14.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="AuditionPlayButton"
                            Content="▶"
                            Width="30"
                            Height="28"
                            Margin="8,0,0,0"
                            Padding="0"
                            ToolTip="{DynamicResource Audition_PlayPause}"
                            Click="AuditionPlayButton_OnClick" />
                    <Button x:Name="AuditionStopButton"
                            Content="■"
                            Width="30"
                            Height="28"
                            Margin="4,0,0,0"
                            Padding="0"
                            ToolTip="{DynamicResource Audition_Stop}"
                            Click="AuditionStopButton_OnClick" />
                    <TextBlock x:Name="AuditionPositionText"
                               Width="94"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="1.1  00:00"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <TextBlock Text="{DynamicResource Editor_Hint}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>
        </Border>

        <Popup x:Name="AuditionVolumePopup"
               PlacementTarget="{Binding ElementName=AuditionVolumeButton}"
               Placement="Top"
               HorizontalOffset="-7"
               VerticalOffset="-6"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Width="44"
                    Height="150"
                    Padding="6,12"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Slider x:Name="AuditionVolumeSlider"
                        Width="30"
                        HorizontalAlignment="Center"
                        Orientation="Vertical"
                        Style="{StaticResource AuditionVolumeSliderStyle}"
                        Minimum="0"
                        Maximum="1"
                        Value="0.8"
                        SmallChange="0.01"
                        LargeChange="0.1"
                        TickFrequency="0.1"
                        ValueChanged="AuditionVolumeSlider_OnValueChanged" />
            </Border>
        </Popup>

        <Popup x:Name="NoteEditorPopup"
               PlacementTarget="{Binding ElementName=Surface}"
               Placement="Relative"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border MinWidth="330"
                    MaxWidth="500"
                    Padding="16"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    PreviewKeyDown="NoteEditorPopup_OnPreviewKeyDown">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Editor_NoteDurationTitle}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,14,0,7"
                               Text="{DynamicResource Editor_RhythmLength}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ListBox x:Name="RhythmLengthListBox"
                             HorizontalAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectedIndex="2"
                             SelectionChanged="RhythmLengthListBox_OnSelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="MinWidth" Value="44" />
                                <Setter Property="Padding" Value="4,6" />
                                <Setter Property="Margin" Value="2,0" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="OptionBorder"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{DynamicResource ControlBackgroundBrush}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="1/1" Tag="4" />
                        <ListBoxItem Content="1/2" Tag="2" />
                        <ListBoxItem Content="1/4" Tag="1" />
                        <ListBoxItem Content="1/8" Tag="0.5" />
                        <ListBoxItem Content="1/16" Tag="0.25" />
                        <ListBoxItem Content="1/32" Tag="0.125" />
                    </ListBox>

                    <DockPanel Margin="0,16,0,6">
                        <TextBlock DockPanel.Dock="Right"
                                   x:Name="GateRatioText"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{DynamicResource Editor_GateRatio}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </DockPanel>
                    <Slider x:Name="GateRatioSlider"
                            Minimum="10"
                            Maximum="95"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="GateRatioSlider_OnValueChanged" />
                    <TextBlock x:Name="GateRatioDescription"
                               Margin="0,7,0,0"
                               MinHeight="34"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />

                    <UniformGrid Margin="-3,12,-3,0" Rows="1" Columns="4">
                        <Button Content="{DynamicResource Editor_Staccato30}"
                                Tag="30"
                                Padding="8,5"
                                Margin="3,0"
                                Click="GatePreset_OnClick" />
                        <Button Content="{DynamicResource Editor_Detached50}"
                                Tag="50"
                                Padding="8,5"
                                Margin="3,0"
                                Click="GatePreset_OnClick" />
                        <Button Content="{DynamicResource Editor_Natural80}"
                                Tag="80"
                                Padding="8,5"
                                Margin="3,0"
                                Click="GatePreset_OnClick" />
                        <Button Content="{DynamicResource Editor_Legato95}"
                                Tag="95"
                                Padding="8,5"
                                Margin="3,0"
                                Click="GatePreset_OnClick" />
                    </UniformGrid>

                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
