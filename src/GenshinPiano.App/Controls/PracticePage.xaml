<UserControl x:Class="GenshinPiano.App.Controls.PracticePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GenshinPiano.App.Controls"
             Focusable="True"
             InputMethod.IsInputMethodEnabled="False"
             PreviewKeyDown="PracticePage_OnPreviewKeyDown"
             PreviewKeyUp="PracticePage_OnPreviewKeyUp">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20,13"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Practice_PageEyebrow}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding ScoreTitle}"
                               Margin="0,2,0,0"
                               FontSize="19"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{DynamicResource Practice_PlaybackSpeed}" />
                    <ComboBox x:Name="PlaybackSpeedBox" Width="72" Margin="0,0,10,0"
                              SelectedIndex="2" SelectionChanged="PlaybackSpeedBox_OnSelectionChanged">
                        <ComboBoxItem Tag="0.25">25%</ComboBoxItem>
                        <ComboBoxItem Tag="0.5">50%</ComboBoxItem>
                        <ComboBoxItem Tag="1">100%</ComboBoxItem>
                        <ComboBoxItem Tag="1.25">125%</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{DynamicResource Practice_NoteSpacing}" />
                    <ComboBox x:Name="NoteSpacingBox" Width="72" Margin="0,0,10,0"
                              SelectedIndex="0" SelectionChanged="NoteSpacingBox_OnSelectionChanged">
                        <ComboBoxItem Tag="1">100%</ComboBoxItem>
                        <ComboBoxItem Tag="1.25">125%</ComboBoxItem>
                        <ComboBoxItem Tag="1.5">150%</ComboBoxItem>
                        <ComboBoxItem Tag="2">200%</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{DynamicResource Practice_Instrument}" />
                    <ComboBox x:Name="PracticeInstrumentBox" Width="132" Margin="0,0,10,0"
                              SelectedIndex="0" SelectionChanged="PracticeInstrumentBox_OnSelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Audition_WindsongLyre}" Tag="-1" />
                        <ComboBoxItem Content="{DynamicResource Audition_FloralZither}" Tag="-2" />
                        <ComboBoxItem Content="{DynamicResource Audition_OldFloralZither}" Tag="-3" />
                        <ComboBoxItem Content="{DynamicResource Audition_VintageLyre}" Tag="-4" />
                        <ComboBoxItem Content="{DynamicResource Audition_Ukulele}" Tag="-5" />
                        <ComboBoxItem Content="{DynamicResource Audition_LingeringEuphonia}" Tag="-6" />
                        <ComboBoxItem Content="{DynamicResource Audition_LeapingSpiritPiano}" Tag="-7" />
                    </ComboBox>
                    <Border Margin="0,0,10,0"
                            Padding="3"
                            Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FollowModeButton" MinWidth="92"
                                         GroupName="PracticeMode" IsChecked="True"
                                         Style="{StaticResource SegmentToggleButtonStyle}"
                                         Click="FollowModeButton_OnClick"
                                         Content="{DynamicResource Practice_FollowMode}" />
                            <RadioButton x:Name="TimedModeButton" MinWidth="92" Margin="3,0,0,0"
                                         GroupName="PracticeMode"
                                         Style="{StaticResource SegmentToggleButtonStyle}"
                                         Click="TimedModeButton_OnClick"
                                         Content="{DynamicResource Practice_TimedMode}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,14,0"
                            Padding="3"
                            Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GameKeysModeButton"
                                    MinWidth="112"
                                    GroupName="PracticeViewMode"
                                    Style="{StaticResource SegmentToggleButtonStyle}"
                                    Click="GameKeysModeButton_OnClick"
                                    Content="{DynamicResource Practice_ModeGameKeys}" />
                            <RadioButton x:Name="VerticalRollModeButton"
                                    MinWidth="112"
                                    Margin="3,0,0,0"
                                    GroupName="PracticeViewMode"
                                    Style="{StaticResource SegmentToggleButtonStyle}"
                                    Click="VerticalRollModeButton_OnClick"
                                    Content="{DynamicResource Practice_ModeVerticalRoll}" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartPracticeButton"
                            MinWidth="96"
                            Padding="16,7"
                            Click="StartPracticeButton_OnClick"
                            Content="{DynamicResource Practice_Start}" />
                    <Button MinWidth="72"
                            Margin="8,0,0,0"
                            Padding="13,7"
                            Click="StopPracticeButton_OnClick"
                            Content="{DynamicResource Practice_Stop}" />
                </StackPanel>
            </Grid>
        </Border>

        <local:PracticeSurface x:Name="Surface"
                               Grid.Row="1"
                               Focusable="True"
             InputMethod.IsInputMethodEnabled="False"
                               PracticeKeyPressed="Surface_OnPracticeKeyPressed"
                               Score="{Binding CurrentScore}" />

        <Border Grid.Row="2"
                Padding="18,9"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PracticeStatusText" Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Practice_Ready}" />
                    <TextBlock Margin="18,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Practice_ImeHint}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Practice_Combo}" />
                    <TextBlock x:Name="ComboText" MinWidth="34" Margin="6,0,12,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="0" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Practice_Accuracy}" />
                    <TextBlock x:Name="AccuracyText" MinWidth="44" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="—" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
