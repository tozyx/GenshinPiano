<UserControl x:Class="GenshinPiano.App.Controls.PracticePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GenshinPiano.App.Controls"
             Focusable="True"
             InputMethod.IsInputMethodEnabled="False"
             PreviewKeyDown="PracticePage_OnPreviewKeyDown"
             PreviewKeyUp="PracticePage_OnPreviewKeyUp">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20,13"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="{DynamicResource Practice_PageEyebrow}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding ScoreTitle}"
                               Margin="0,2,0,0"
                               FontSize="19"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.ColumnSpan="2" Panel.ZIndex="2"
                            Margin="0,0,367,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Border x:Name="PlaybackSpeedOption" Margin="0,0,8,0" ClipToBounds="True"
                                    MouseEnter="PracticeOption_OnMouseEnter" MouseLeave="PracticeOption_OnMouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{DynamicResource Practice_PlaybackSpeed}" />
                                    <Grid Width="0" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                                        <ComboBox x:Name="PlaybackSpeedBox" Width="96"
                                                  HorizontalAlignment="Left"
                                                  SelectedIndex="2" SelectionChanged="PlaybackSpeedBox_OnSelectionChanged"
                                                  PreviewMouseLeftButtonDown="PracticeOptionCombo_OnPreviewMouseLeftButtonDown"
                                                  DropDownClosed="PracticeOption_OnDropDownClosed">
                                    <ComboBoxItem Tag="0.25">25%</ComboBoxItem>
                                    <ComboBoxItem Tag="0.5">50%</ComboBoxItem>
                                    <ComboBoxItem Tag="1">100%</ComboBoxItem>
                                    <ComboBoxItem Tag="1.25">125%</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NoteSpacingOption" Margin="0,0,8,0" ClipToBounds="True"
                                    MouseEnter="PracticeOption_OnMouseEnter" MouseLeave="PracticeOption_OnMouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{DynamicResource Practice_NoteSpacing}" />
                                    <Grid Width="0" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                                        <ComboBox x:Name="NoteSpacingBox" Width="96"
                                                  HorizontalAlignment="Left"
                                                  SelectedIndex="0" SelectionChanged="NoteSpacingBox_OnSelectionChanged"
                                                  PreviewMouseLeftButtonDown="PracticeOptionCombo_OnPreviewMouseLeftButtonDown"
                                                  DropDownClosed="PracticeOption_OnDropDownClosed">
                                    <ComboBoxItem Tag="1">100%</ComboBoxItem>
                                    <ComboBoxItem Tag="1.25">125%</ComboBoxItem>
                                    <ComboBoxItem Tag="1.5">150%</ComboBoxItem>
                                    <ComboBoxItem Tag="2">200%</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="InstrumentOption" Margin="0,0,8,0" ClipToBounds="True"
                                    MouseEnter="PracticeOption_OnMouseEnter" MouseLeave="PracticeOption_OnMouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{DynamicResource Practice_Instrument}" />
                                    <Grid Width="0" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                                        <ComboBox x:Name="PracticeInstrumentBox" Width="168"
                                                  HorizontalAlignment="Left"
                                                  SelectedIndex="0" SelectionChanged="PracticeInstrumentBox_OnSelectionChanged"
                                                  PreviewMouseLeftButtonDown="PracticeOptionCombo_OnPreviewMouseLeftButtonDown"
                                                  DropDownClosed="PracticeOption_OnDropDownClosed">
                                    <ComboBoxItem Content="{DynamicResource Audition_WindsongLyre}" Tag="-1" />
                                    <ComboBoxItem Content="{DynamicResource Audition_FloralZither}" Tag="-2" />
                                    <ComboBoxItem Content="{DynamicResource Audition_OldFloralZither}" Tag="-3" />
                                    <ComboBoxItem Content="{DynamicResource Audition_VintageLyre}" Tag="-4" />
                                    <ComboBoxItem Content="{DynamicResource Audition_Ukulele}" Tag="-5" />
                                    <ComboBoxItem Content="{DynamicResource Audition_LingeringEuphonia}" Tag="-6" />
                                    <ComboBoxItem Content="{DynamicResource Audition_LeapingSpiritPiano}" Tag="-7" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PracticeVolumeOption" Padding="4,0" ClipToBounds="True"
                                    MouseEnter="PracticeVolumeOption_OnMouseEnter"
                                    MouseLeave="PracticeVolumeOption_OnMouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{DynamicResource Audition_Volume}" />
                                    <Grid x:Name="PracticeVolumeReveal" Width="0" Opacity="0"
                                          IsHitTestVisible="False" ClipToBounds="True">
                                        <Grid Width="170" Height="28">
                                            <Border Height="4" Margin="6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource BorderBrush}"
                                                    CornerRadius="2" />
                                            <Border x:Name="PracticeVolumeValueTrack"
                                                    Width="0" Height="4" Margin="6,0,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="2" />
                                            <Slider x:Name="PracticeVolumeSlider" Width="170"
                                                    Minimum="0" Maximum="1" Value="0.8"
                                                    SmallChange="0.01" LargeChange="0.1" TickFrequency="0.1"
                                                    Style="{StaticResource SharedAuditionHorizontalVolumeSliderStyle}"
                                                    SizeChanged="PracticeVolumeSlider_OnSizeChanged"
                                                    MouseEnter="PracticeVolumeSlider_OnMouseEnter"
                                                    MouseLeave="PracticeVolumeSlider_OnMouseLeave"
                                                    PreviewMouseLeftButtonDown="PracticeVolumeSlider_OnPreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="PracticeVolumeSlider_OnPreviewMouseMove"
                                                    PreviewMouseLeftButtonUp="PracticeVolumeSlider_OnPreviewMouseLeftButtonUp"
                                                    ValueChanged="PracticeVolumeSlider_OnValueChanged" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Grid x:Name="PracticeModeTabsHost" Width="155" Height="29" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FollowModeButton" Width="76"
                                         GroupName="PracticeMode" IsChecked="True"
                                         Style="{StaticResource BrowserTabButtonStyle}"
                                         Click="FollowModeButton_OnClick"
                                         Content="{DynamicResource Practice_FollowMode}" />
                            <RadioButton x:Name="TimedModeButton" Width="76" Margin="3,0,0,0"
                                         GroupName="PracticeMode"
                                         Style="{StaticResource BrowserTabButtonStyle}"
                                         Click="TimedModeButton_OnClick"
                                         Content="{DynamicResource Practice_TimedMode}" />
                        </StackPanel>
                        <Border x:Name="PracticeModeTabIndicator" Width="58" Height="3"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform X="9" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Border Width="2" Height="25" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="1" Opacity="0.8" />
                    <Grid x:Name="ViewTabsHost" Width="180" Height="31">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GameKeysModeButton" Width="88"
                                         GroupName="PracticeViewMode"
                                         Style="{StaticResource BrowserTabButtonStyle}"
                                         Click="GameKeysModeButton_OnClick"
                                         Content="{DynamicResource Practice_ModeGameKeys}" />
                            <RadioButton x:Name="VerticalRollModeButton" Width="88" Margin="4,0,0,0"
                                         GroupName="PracticeViewMode"
                                         Style="{StaticResource BrowserTabButtonStyle}"
                                         Click="VerticalRollModeButton_OnClick"
                                         Content="{DynamicResource Practice_ModeVerticalRoll}" />
                        </StackPanel>
                        <Border x:Name="ViewTabIndicator" Width="70" Height="3"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform X="101" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <local:PracticeSurface x:Name="Surface"
                               Grid.Row="1"
                               Focusable="True"
             InputMethod.IsInputMethodEnabled="False"
                               PracticeKeyPressed="Surface_OnPracticeKeyPressed"
                               Score="{Binding CurrentScore}" />

        <Border Grid.Row="2"
                MinHeight="32"
                Padding="18,2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock x:Name="PracticeStatusText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Practice_Ready}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Grid x:Name="CalibrationReveal" Width="0" Opacity="0" ClipToBounds="True">
                        <Button x:Name="RhythmGameSettingsButton" IsEnabled="False"
                                Width="28" HorizontalAlignment="Left"
                                Style="{StaticResource PracticeTransportButtonStyle}"
                                ToolTip="{DynamicResource Menu_Settings}" Click="RhythmGameSettings_OnClick"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform><TranslateTransform X="18" /></Button.RenderTransform>
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.45" StrokeLineJoin="Round"
                                  Data="M8.5,1.5 L9.5,3.1 L11.3,3.5 L12.8,2.6 L14.4,4.2 L13.5,5.7 L13.9,7.5 L15.5,8.5 L13.9,9.5 L13.5,11.3 L14.4,12.8 L12.8,14.4 L11.3,13.5 L9.5,13.9 L8.5,15.5 L7.5,13.9 L5.7,13.5 L4.2,14.4 L2.6,12.8 L3.5,11.3 L3.1,9.5 L1.5,8.5 L3.1,7.5 L3.5,5.7 L2.6,4.2 L4.2,2.6 L5.7,3.5 L7.5,3.1 Z M8.5,6 A2.5,2.5 0 1 1 8.49,6" />
                        </Button>
                        <Button x:Name="CalibrationButton" IsEnabled="False"
                                Margin="28,0,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource PracticeTransportButtonStyle}"
                                ToolTip="{DynamicResource Practice_Latency}" Click="Calibrate_OnClick"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform><TranslateTransform X="10" /></Button.RenderTransform>
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.5" Data="M 8,1 A 7,7 0 1 1 7.99,1 M 8,4 L 8,8 L 11,10" />
                        </Button>
                    </Grid>
                    <ToggleButton x:Name="RhythmGameToggle" Margin="0,0,2,0"
                                  Style="{StaticResource PracticeToggleIconButtonStyle}"
                                  ToolTip="{DynamicResource Practice_RhythmGame}"
                                  Click="RhythmGameToggle_OnClick">
                        <Grid Width="17" Height="17">
                            <Path x:Name="RhythmGameNoteIcon" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M6,3 V12.2 C6,14.1 2.2,14.6 2.2,12.5 C2.2,10.6 6,10.2 6,12 M6,5 L14,3 V10.2 C14,12.1 10.2,12.6 10.2,10.5 C10.2,8.6 14,8.2 14,10 M6,7 L14,5" />
                        </Grid>
                    </ToggleButton>
                    <Button x:Name="ReturnBookmarkButton" IsEnabled="False" Style="{StaticResource PracticeTransportButtonStyle}"
                            ToolTip="{DynamicResource Practice_BookmarkReturn}" Click="ReturnToBookmark_OnClick">
                        <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource PrimaryTextBrush}"
                              StrokeThickness="1.7" Data="M 4,3 L 4,13 M 13,3 L 5,8 L 13,13 Z" />
                    </Button>
                    <Button x:Name="StartPracticeButton" Margin="0,0,2,0"
                            Style="{StaticResource PracticeTransportButtonStyle}"
                            ToolTip="{DynamicResource Practice_Start}"
                            Click="StartPracticeButton_OnClick">
                        <Grid Width="17" Height="17">
                            <Path x:Name="PracticePlayIcon" Margin="2"
                                  Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform"
                                  Data="M2.5,0.7 Q1.5,0.2 1.5,1.8 L1.5,14.2 Q1.5,15.8 2.5,15.3 L13.8,8.8 Q15.2,8 13.8,7.2 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Path.RenderTransform>
                            </Path>
                            <Grid x:Name="PracticePauseIcon" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform ScaleX=".65" ScaleY=".65" /></Grid.RenderTransform>
                                <Rectangle Width="4.5" Height="16" Margin="0,0,8,0" RadiusX="1"
                                           Fill="{DynamicResource PrimaryTextBrush}" />
                                <Rectangle Width="4.5" Height="16" Margin="8,0,0,0" RadiusX="1"
                                           Fill="{DynamicResource PrimaryTextBrush}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button Margin="0,0,12,0"
                            Style="{StaticResource PracticeTransportButtonStyle}"
                            ToolTip="{DynamicResource Practice_Stop}"
                            Click="StopPracticeButton_OnClick">
                        <Rectangle Width="10" Height="10" RadiusX="1" RadiusY="1"
                                   Fill="{DynamicResource StopIconBrush}" />
                    </Button>
                    <Border Width="1" Height="20" Margin="0,0,12,0"
                            VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Practice_Combo}" />
                    <TextBlock x:Name="ComboText" MinWidth="34" Margin="6,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="0" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Practice_Accuracy}" />
                    <TextBlock x:Name="AccuracyText" MinWidth="44" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="—" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
