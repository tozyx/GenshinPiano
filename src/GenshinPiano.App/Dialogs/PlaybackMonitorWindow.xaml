<Window x:Class="GenshinPiano.App.Dialogs.PlaybackMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390"
        Height="170"
        Style="{StaticResource AppWindowStyle}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SourceInitialized="PlaybackMonitorWindow_OnSourceInitialized"
        Closing="PlaybackMonitorWindow_OnClosing">
    <Window.Resources>
        <Style x:Key="MonitorIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.07" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.07" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.91" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.91" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.07" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.07" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonitorStopButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MonitorIconButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●"
                                   Margin="0,0,8,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{DynamicResource Monitor_Title}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="30"
                            Height="28"
                            Padding="0"
                            Content="↗"
                            ToolTip="{DynamicResource Monitor_ReturnToEditor}"
                            Click="ReturnButton_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ScoreTitle, Mode=OneWay}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,12,0"
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            MinWidth="58"
                            Padding="10,5"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSurfaceBrush}"
                            CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   Text="{Binding PlaybackCurrentKeys, Mode=OneWay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="5"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding PlaybackProgressPercent, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar"
                                   BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaybackPaused, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="#F2B84B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <Button Grid.Column="1"
                            Style="{StaticResource MonitorIconButtonStyle}"
                            ToolTip="{DynamicResource Action_Play}"
                            Command="{Binding TogglePlaybackCommand}">
                        <Grid Width="13" Height="14">
                            <Path Fill="{DynamicResource PrimaryTextBrush}"
                                  Stretch="Uniform"
                                  Data="M 1,0 L 13,7 L 1,14 Z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPlaying, Mode=OneWay}" Value="True" />
                                                    <Condition Binding="{Binding IsPlaybackPaused, Mode=OneWay}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Fill="{DynamicResource PrimaryTextBrush}"
                                  Stretch="Uniform"
                                  Data="M 0,0 H 4 V 14 H 0 Z M 9,0 H 13 V 14 H 9 Z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPlaying, Mode=OneWay}" Value="True" />
                                                    <Condition Binding="{Binding IsPlaybackPaused, Mode=OneWay}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2"
                            Margin="7,0,0,0"
                            Style="{StaticResource MonitorStopButtonStyle}"
                            ToolTip="{DynamicResource Action_Stop}"
                            Command="{Binding StopCommand}">
                        <Rectangle Width="11"
                                   Height="11"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Fill="{DynamicResource PrimaryTextBrush}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0,7,0,0">
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="{DynamicResource Monitor_Progress}" />
                        <Run Text=" " />
                        <Run Text="{Binding PlaybackChordIndex, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding PlaybackChordCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="{DynamicResource Monitor_CurrentKeys}" />
                    </TextBlock>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
