<Window x:Class="GenshinPiano.App.Dialogs.UpdateSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Update_OverviewTitle}" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="{DynamicResource AppFontFamily}">
    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock Text="{DynamicResource Update_OverviewTitle}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Update_ApplicationLabel}" Margin="0,20,0,6" FontWeight="SemiBold" />
            <TextBlock x:Name="ApplicationVersionText" TextWrapping="Wrap" />
            <TextBlock x:Name="ApplicationStatusText" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="{DynamicResource Update_OcrLabel}" Margin="0,20,0,6" FontWeight="SemiBold" />
            <TextBlock x:Name="OcrVersionText" TextWrapping="Wrap" />
            <TextBlock x:Name="OcrStatusText" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <ProgressBar x:Name="OcrProgress" Height="4" Margin="0,12,0,0" Maximum="1" Visibility="Collapsed" />
            <TextBlock Text="{DynamicResource Update_IndependentChoices}" TextWrapping="Wrap" Margin="0,18,0,20"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="ApplicationButton" MinWidth="126" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Application_OnClick" />
                <Button x:Name="OcrButton" MinWidth="116" Margin="0,0,8,0"
                        Background="{DynamicResource SurfaceBrush}"
                        Style="{StaticResource AppButtonStyle}" Click="Ocr_OnClick" />
                <Button MinWidth="76" Content="{DynamicResource Common_Cancel}"
                        Background="{DynamicResource SurfaceBrush}"
                        Style="{StaticResource AppButtonStyle}" Click="Cancel_OnClick" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
