<Window x:Class="GenshinPiano.App.Dialogs.AiScoreImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AiImport_Title}"
        Width="900" Height="720" MinWidth="680" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFontFamily}" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="9,9,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <TextBlock Margin="18,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{DynamicResource AiImport_Title}" />
                    <Button Width="44" Height="38" HorizontalAlignment="Right" Padding="0"
                            Background="Transparent" BorderThickness="0" Content="✕" Click="Cancel_OnClick" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="20,16,20,0">
                <TextBlock Text="{DynamicResource AiImport_Instructions}" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <WrapPanel Margin="0,12,0,8">
                    <Button Margin="0,0,8,6" Padding="14,7" Style="{StaticResource AppButtonStyle}"
                            Content="{DynamicResource AiImport_CopyPrompt}" Click="CopyPrompt_OnClick" />
                    <Button x:Name="PasteButton" Margin="0,0,8,6" Padding="14,7" Style="{StaticResource AppButtonStyle}"
                            Content="{DynamicResource AiImport_Paste}" Click="Paste_OnClick" />
                    <Button x:Name="FileButton" Margin="0,0,8,6" Padding="14,7" Style="{StaticResource AppButtonStyle}"
                            Content="{DynamicResource AiImport_OpenFile}" Click="OpenFile_OnClick" />
                </WrapPanel>
            </StackPanel>
            <Grid Grid.Row="2" Margin="20,0,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="130" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="JsonTextBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13" Padding="10" MaxLength="2000000"
                         TextChanged="JsonText_OnChanged"
                         AutomationProperties.Name="{DynamicResource AiImport_JsonText}" />
                <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,10,0,7"
                           Text="{DynamicResource AiImport_Ready}" TextWrapping="Wrap" />
                <TextBox x:Name="ReviewTextBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="9"
                         AutomationProperties.Name="{DynamicResource AiImport_Review}" />
                <CheckBox x:Name="ReviewCheckBox" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed"
                          Checked="Review_OnChanged" Unchecked="Review_OnChanged">
                    <TextBlock Text="{DynamicResource AiImport_Acknowledge}" TextWrapping="Wrap" />
                </CheckBox>
            </Grid>
            <Grid Grid.Row="3" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CopyReportButton" HorizontalAlignment="Left" Padding="12,7"
                        IsEnabled="False" Style="{StaticResource AppButtonStyle}"
                        Content="{DynamicResource AiImport_CopyReport}" Click="CopyReport_OnClick" />
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Margin="8,0,0,0" Padding="14,8" Style="{StaticResource AppButtonStyle}"
                            Content="{DynamicResource Action_Cancel}" Click="Cancel_OnClick" IsCancel="True" />
                    <Button x:Name="ValidateButton" Margin="8,0,0,0" Padding="14,8"
                            Style="{StaticResource AppButtonStyle}" IsEnabled="False"
                            Content="{DynamicResource AiImport_Validate}" Click="Validate_OnClick" />
                    <Button x:Name="ImportButton" Margin="8,0,0,0" Padding="14,8" IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Action_Import}" Click="Import_OnClick" />
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
