<Window x:Class="GenshinPiano.App.Dialogs.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dialog_UnsavedChangesTitle}"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_OnKeyDown">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <TextBlock Margin="14,0,48,0"
                               Text="{DynamicResource Dialog_UnsavedChangesTitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button HorizontalAlignment="Right"
                            Width="46"
                            Height="35"
                            Content="✕"
                            Padding="0"
                            FontSize="13"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            ToolTip="{DynamicResource Window_Close}"
                            Click="CancelButton_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,24,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34"
                        Height="34"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentSurfaceBrush}"
                        CornerRadius="17">
                    <TextBlock Text="!"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Dialog_UnsavedChangesHeading}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{DynamicResource Dialog_UnsavedChangesMessage}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Padding="16,12,16,16"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0,0,9,9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="112"
                            Height="36"
                            Margin="0"
                            Content="{DynamicResource Action_Cancel}"
                            Style="{StaticResource AppButtonStyle}"
                            Click="CancelButton_OnClick" />
                    <Button Width="112"
                            Height="36"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Action_DontSave}"
                            Style="{StaticResource AppButtonStyle}"
                            Click="DontSaveButton_OnClick" />
                    <Button Width="112"
                            Height="36"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Action_Save}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Click="SaveButton_OnClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
