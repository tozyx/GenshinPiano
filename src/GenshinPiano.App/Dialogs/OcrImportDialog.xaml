<Window x:Class="GenshinPiano.App.Dialogs.OcrImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ocr_Title}"
        Width="560"
        Height="432"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="OcrToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="34" Height="18" CornerRadius="9"
                                    Background="{TemplateBinding Background}">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource SecondaryTextBrush}" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="14,0,6,0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="32" Height="28" Padding="0"
                            Content="✕" Background="Transparent" BorderThickness="0"
                            Click="CloseButton_OnClick" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                               Text="{DynamicResource Ocr_Title}" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <Button x:Name="DownloadAddonButton" DockPanel.Dock="Right" Margin="12,0,0,0"
                            Content="{DynamicResource Ocr_DownloadAddon}"
                            Style="{StaticResource AppButtonStyle}"
                            Click="DownloadAddonButton_OnClick" />
                    <TextBlock x:Name="AddonStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Ocr_Image}" />
                    <Border Grid.Column="1" Height="36" Padding="10,0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <TextBlock x:Name="ImagePathText" VerticalAlignment="Center"
                                   Text="{DynamicResource Ocr_NotSelected}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                    <Button Grid.Column="2" Margin="8,0,0,0"
                            Content="{DynamicResource Ocr_Browse}"
                            Style="{StaticResource AppButtonStyle}" Click="Browse_OnClick" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Ocr_Notation}" />
                    <ComboBox x:Name="NotationComboBox" Grid.Column="1" Height="36" SelectedIndex="0">
                        <ComboBoxItem Tag="Numbered" Content="{DynamicResource Ocr_NotationNumbered}" />
                        <ComboBoxItem Tag="Staff" Content="{DynamicResource Ocr_NotationStaff}" />
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Ocr_Watermark}" />
                    <ComboBox x:Name="WatermarkComboBox" Grid.Column="1" Height="36" SelectedIndex="0">
                        <ComboBoxItem Tag="Auto" Content="{DynamicResource Ocr_WatermarkAuto}" />
                        <ComboBoxItem Tag="Strong" Content="{DynamicResource Ocr_WatermarkStrong}" />
                        <ComboBoxItem Tag="Off" Content="{DynamicResource Ocr_WatermarkOff}" />
                    </ComboBox>
                    <ToggleButton x:Name="AccompanimentCheckBox" Grid.Column="3"
                                  VerticalAlignment="Center" IsChecked="True"
                                  Style="{StaticResource OcrToggleStyle}"
                                  Content="{DynamicResource Ocr_IncludeAccompaniment}" />
                </Grid>

                <ToggleButton x:Name="AutoMapTo21CheckBox" Grid.Row="4" Margin="0,12,0,0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource OcrToggleStyle}"
                              Content="{DynamicResource Ocr_AutoMapTo21}" />

                <ProgressBar x:Name="AnalysisProgress" Grid.Row="5" Height="5" Margin="0,16,0,0"
                             Minimum="0" Maximum="1" Value="0"
                             Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="ResultText" Grid.Row="6" Margin="0,10,0,0"
                           Text="{DynamicResource Ocr_Ready}" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <StackPanel Grid.Row="7" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="{DynamicResource Common_Cancel}"
                            Style="{StaticResource AppButtonStyle}" Click="CancelButton_OnClick" />
                    <Button x:Name="AnalyzeButton" Margin="8,0,0,0"
                            Content="{DynamicResource Ocr_Analyze}" IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}" Click="AnalyzeButton_OnClick" />
                    <Button x:Name="ImportButton" Margin="8,0,0,0"
                            Content="{DynamicResource Ocr_Import}" Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}" Click="ImportButton_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
