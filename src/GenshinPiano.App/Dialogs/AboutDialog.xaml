<Window x:Class="GenshinPiano.App.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="24">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AboutIcon"
                       Width="48"
                       Height="48"
                       Stretch="Uniform"/>
                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="GenshinPiano"
                               FontSize="21"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,18,0,0"
                       Text="{DynamicResource About_Description}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <Border Margin="0,18,0,0"
                    Padding="14"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About_License}"
                               FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0"
                               Text="{DynamicResource About_SourceAndFeedback}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Margin="0,8,0,0"
                               Text="github.com/tozyx/GenshinPiano"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,22,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="120"
                        Height="36"
                        Content="{DynamicResource About_OpenGitHub}"
                        Style="{StaticResource AppButtonStyle}"
                        Click="OpenGitHub_OnClick"/>
                <Button Width="100"
                        Height="36"
                        Margin="8,0,0,0"
                        Content="{DynamicResource Update_Close}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Close_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
