<Window x:Class="GenshinPiano.App.Dialogs.ScoreAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Padding="24"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel>
            <TextBlock Text="{DynamicResource ScoreTools_Title}"
                       FontSize="19"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0"
                       Text="{DynamicResource ScoreTools_Description}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

            <Border Margin="0,18,0,0"
                    Padding="14"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource ScoreTools_TotalNotes}" />
                    <TextBlock x:Name="TotalNotesText" Grid.Column="1" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Margin="0,8,20,0" Text="{DynamicResource ScoreTools_UnmappedNotes}" />
                    <TextBlock x:Name="UnmappedNotesText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Margin="0,8,20,0" Text="{DynamicResource ScoreTools_DuplicateNotes}" />
                    <TextBlock x:Name="DuplicateNotesText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="3" Margin="0,8,20,0" Text="{DynamicResource ScoreTools_OverlappingNotes}" />
                    <TextBlock x:Name="OverlappingNotesText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Margin="0,8,20,0" Text="{DynamicResource ScoreTools_VeryShortNotes}" />
                    <TextBlock x:Name="VeryShortNotesText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <TextBlock Margin="0,18,0,0"
                       Text="{DynamicResource ScoreTools_CleanupTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,10"
                       Text="{DynamicResource ScoreTools_CleanupDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <StackPanel>
                <CheckBox x:Name="RemoveDuplicatesCheckBox"
                          Margin="0,3"
                          Content="{DynamicResource ScoreTools_RemoveDuplicates}"
                          Checked="CleanupOption_OnChanged"
                          Unchecked="CleanupOption_OnChanged" />
                <CheckBox x:Name="TrimOverlapsCheckBox"
                          Margin="0,3"
                          Content="{DynamicResource ScoreTools_TrimOverlaps}"
                          Checked="CleanupOption_OnChanged"
                          Unchecked="CleanupOption_OnChanged" />
                <CheckBox x:Name="RemoveVeryShortCheckBox"
                          Margin="0,3"
                          Content="{DynamicResource ScoreTools_RemoveVeryShort}"
                          Checked="CleanupOption_OnChanged"
                          Unchecked="CleanupOption_OnChanged" />
            </StackPanel>
            <Button x:Name="ApplyCleanupButton"
                    Width="132"
                    Height="34"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ScoreTools_ApplyCleanup}"
                    Style="{StaticResource AppButtonStyle}"
                    Click="ApplyCleanup_OnClick" />

            <TextBlock Margin="0,18,0,0"
                       Text="{DynamicResource ScoreTools_TransposeTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,10"
                       Text="{DynamicResource ScoreTools_TransposeDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <UniformGrid Rows="1" Columns="4">
                <Button x:Name="DownOctaveButton" Height="34" Margin="0,0,5,0" Content="−7" Tag="-7" Style="{StaticResource AppButtonStyle}" Click="Transpose_OnClick" />
                <Button x:Name="DownSemitoneButton" Height="34" Margin="5,0" Content="−1" Tag="-1" Style="{StaticResource AppButtonStyle}" Click="Transpose_OnClick" />
                <Button x:Name="UpSemitoneButton" Height="34" Margin="5,0" Content="+1" Tag="1" Style="{StaticResource AppButtonStyle}" Click="Transpose_OnClick" />
                <Button x:Name="UpOctaveButton" Height="34" Margin="5,0,0,0" Content="+7" Tag="7" Style="{StaticResource AppButtonStyle}" Click="Transpose_OnClick" />
            </UniformGrid>

            <TextBlock Margin="0,18,0,0"
                       Text="{DynamicResource ScoreTools_MapTo21Title}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,10"
                       Text="{DynamicResource ScoreTools_MapTo21Description}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Button Width="180" Height="34" HorizontalAlignment="Left"
                    Content="{DynamicResource ScoreTools_MapTo21Action}"
                    Style="{StaticResource AppButtonStyle}"
                    Click="MapToGenshin21_OnClick" />

            <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="100" Height="36" Content="{DynamicResource Update_Close}" Style="{StaticResource PrimaryButtonStyle}" Click="Close_OnClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
