<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Managed OCR code ships in the application. Only its worker mode loads resources. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>GPianoOcrEngine</AssemblyName>
    <RootNamespace>GenshinPiano.Ocr.Engine</RootNamespace>
    <AssemblyTitle>GPiano OCR Engine</AssemblyTitle>
    <Product>GPiano OCR Add-on</Product>
    <Description>GPiano OCR Engine</Description>
    <Company>tozyx</Company>
    <Authors>tozyx</Authors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GenshinPiano.Application\GenshinPiano.Application.csproj" />
    <ProjectReference Include="..\GenshinPiano.Core\GenshinPiano.Core.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
    <PackageReference Include="RapidOcrNet" Version="2.0.0" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>
</Project>
